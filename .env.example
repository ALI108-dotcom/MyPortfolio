# =========================================================================
# SUPABASE & VERCEL ENVIRONMENT VARIABLES
# =========================================================================
# Copy these into your Vercel Project Settings:
# (Vercel Dashboard -> Your Project -> Settings -> Environment Variables)
#
# Obtain these values from your Supabase Dashboard:
# (Supabase Dashboard -> Project Settings -> API)
# =========================================================================

# 1. Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (used for secure client & serverless access)
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. (Optional) Supabase Service Role Key (for administrative access)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
